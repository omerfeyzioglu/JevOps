# Optional provider credentials. Keep actual values in your environment or .env.
TYPESAFE_API_KEY=
OPENAI_API_KEY=
OPENAI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LAYA_ENABLED=true
LAYA_MODEL=convaiinnovations/laya
# Empty uses Laya's general English checkpoint. Set explicitly for another checkpoint.
LAYA_SUBFOLDER=
# Leave empty for automatic device selection; Docker uses CPU PyTorch.
LAYA_DEVICE=
# Run providers every Nth evidence snapshot (snapshots arrive once per event tick).
DECISION_EVERY_N_SNAPSHOTS=5
